# Copy this file to .env (gitignored) and fill in real values.
# figma-get auto-loads .env from the directory it runs in.

# Personal access token: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default team for `figma-get team-*` subcommands.
# Find the numeric ID after `/team/` in figma.com URLs.
FIGMA_TEAM_ID=000000000000000000
